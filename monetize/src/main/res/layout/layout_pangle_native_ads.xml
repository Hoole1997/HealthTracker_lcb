<?xml version="1.0" encoding="utf-8"?>
<!-- Pangle 标准原生广告布局 (STANDARD) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:cardCornerRadius="@dimen/dp_4"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_80"
            android:paddingHorizontal="@dimen/dp_10">

            <View
                android:id="@+id/v_div"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:background="#f7f7f7"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 应用图标 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/ads_icon_cv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/dp_8"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ads_content_ll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_div">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ads_iv_icon"
                    android:layout_width="@dimen/dp_44"
                    android:layout_height="@dimen/dp_44"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_info_details" />
            </androidx.cardview.widget.CardView>

            <!-- 广告内容区域 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ads_content_ll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ads_btn_cta"
                app:layout_constraintStart_toEndOf="@id/ads_icon_cv"
                app:layout_constraintTop_toTopOf="parent">

                <!-- 广告标题 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/ads_tv_title"
                    style="@style/TextViewFont_RobotoBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#222222"
                    android:textSize="@dimen/sp_14"
                    tools:text="Test Ads" />

                <!-- 广告描述 -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/ads_tv_description"
                    style="@style/TextViewFont_RobotoRegular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#666666"
                    android:textSize="@dimen/sp_12"
                    tools:text="广告描述" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- CTA按钮 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/ads_btn_cta"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_32"
                android:background="@drawable/bg_ad_cta_button"
                android:backgroundTint="#00DD8B"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_12"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ads_content_ll"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="INSTALL" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- AD 标签 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ads_tv_label"
            android:layout_width="@dimen/dp_27"
            android:layout_height="@dimen/dp_15"
            android:background="@drawable/bg_ad_label_enhanced_gray"
            android:gravity="center"
            android:text="AD"
            android:textColor="#BBBBBB"
            android:textSize="@dimen/sp_11" />

        <!-- Pangle Ad Logo 容器 -->
        <FrameLayout
            android:id="@+id/fl_ad_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/dp_4"
            android:visibility="gone" />

    </androidx.cardview.widget.CardView>

</FrameLayout>
