<?xml version="1.0" encoding="utf-8"?>
<!-- TopOn CARD_4 布局：大媒体区域 + 居中图标 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="0dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 媒体内容容器（替代 MediaView）-->
            <FrameLayout
                android:id="@+id/fl_ad_media"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_200"
                android:background="#f5f5f5" />

            <!-- 应用图标 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/ads_icon_cv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_10"
                app:cardCornerRadius="@dimen/dp_8"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ads_iv_icon"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_info_details" />
            </androidx.cardview.widget.CardView>

            <!-- 广告标题 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/ads_tv_title"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/dp_10"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/dp_16"
                android:singleLine="true"
                android:textColor="#222222"
                android:textSize="@dimen/sp_16"
                tools:text="广告标题" />

            <!-- 广告描述 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/ads_tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/dp_16"
                android:textColor="#666666"
                android:textSize="@dimen/sp_12"
                tools:text="广告描述" />

            <!-- CTA按钮 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/ads_btn_cta"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginBottom="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/bg_ad_cta_button"
                android:backgroundTint="#00DD8B"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/sp_14"
                tools:text="INSTALL" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- AD 标签 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ads_tv_label"
            android:layout_width="@dimen/dp_27"
            android:layout_height="@dimen/dp_17"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@drawable/bg_ad_label_enhanced_gray"
            android:gravity="center"
            android:text="AD"
            android:textColor="#fff"
            android:textSize="@dimen/sp_11" />

    </androidx.cardview.widget.CardView>

</FrameLayout>
