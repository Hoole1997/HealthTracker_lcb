<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@android:color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:animateLayoutChanges="true"
        android:background="@drawable/bg_c1_top_circle_20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/iv_line"
            android:layout_width="@dimen/dp_66"
            android:layout_height="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/ic_dialog_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/rate_emoji"
            android:layout_width="@dimen/dp_106"
            android:layout_height="@dimen/dp_106"
            android:layout_marginTop="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_line"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/json_emoji_celebrate" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/rate_result_title"
            style="@style/TextViewFont_RobotoBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/evaluate_title_doulike"
            android:textColor="@color/t1"
            android:textSize="@dimen/sp_18"
            app:layout_constraintTop_toBottomOf="@id/rate_emoji" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/rate_result_tip"
            style="@style/TextViewFont_RobotoRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_6"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/lib_rate_dialog_tip"
            android:textColor="@color/t2"
            android:textSize="@dimen/sp_14"
            app:layout_constraintTop_toBottomOf="@id/rate_result_title"
            app:autoSizeMaxTextSize="@dimen/sp_14"
            app:autoSizeMinTextSize="@dimen/sp_10"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"/>

        <LinearLayout
            android:id="@+id/star_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_54"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginEnd="@dimen/dp_15"
            android:clipChildren="false"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/rate_result_tip">

            <com.app.raise.widget.StarCheckView
                android:id="@+id/evaluate_star_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.app.raise.widget.StarCheckView
                android:id="@+id/evaluate_star_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.app.raise.widget.StarCheckView
                android:id="@+id/evaluate_star_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.app.raise.widget.StarCheckView
                android:id="@+id/evaluate_star_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.app.raise.widget.StarCheckView
                android:id="@+id/evaluate_star_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rate_hand_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_27"
            android:layout_below="@id/star_layout"
            android:layout_marginStart="@dimen/dp_32"
            android:layout_marginEnd="@dimen/dp_32"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:weightSum="6"
            app:layout_constraintTop_toBottomOf="@id/star_layout">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="5.2"
                style="@style/TextViewFont_RobotoRegular"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/evaluate_txt_clicktips"
                android:textColor="@color/lib_rate_dialog_five_star_tip_color"
                android:textSize="@dimen/sp_14" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/rate_hand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                app:srcCompat="@drawable/lib_rate_five_star_arrow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lib_rate_button_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_34"
            android:layout_marginEnd="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/star_layout">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/lib_rate_button"
                style="@style/TextViewFont_RobotoSignificant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_click_c5_c8_12dp"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="@dimen/dp_48"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10"
                android:text="@string/btn_rate_on_google_play"
                android:textAllCaps="true"
                android:textColor="@color/lib_rate_button_text_color"
                android:textSize="@dimen/sp_17"
                android:visibility="invisible"
                app:autoSizeMaxTextSize="@dimen/sp_17"
                app:autoSizeMinTextSize="@dimen/sp_10"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />


        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
