<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="MaxHeightFrameLayout">
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>


    <declare-styleable name="RulerView">
        <attr name="rulerHeight" format="dimension" />               <!--尺子的高度-->
        <attr name="scaleGap" format="dimension" />                  <!--刻度间距-->
        <attr name="scaleCount" format="integer" />                  <!--刻度数-->
        <attr name="firstScale" format="float" />                    <!--默认选中的刻度-->
        <attr name="maxScale" format="float" />                      <!--最大刻度-->
        <attr name="minScale" format="float" />                      <!--最小刻度-->
        <attr name="scrollableMinScale" format="float" />            <!--可滚动的最小刻度-->
        <attr name="scrollableMaxScale" format="float" />            <!--可滚动的最大刻度-->
        <attr name="scaleStep" format="float" />                     <!--刻度步长-->
        <attr name="bgColor" format="color" />                       <!--背景色-->
        <attr name="smallScaleColor" format="color" />               <!--小刻度的颜色-->
        <attr name="midScaleColor" format="color" />                 <!--中刻度的颜色-->
        <attr name="largeScaleColor" format="color" />               <!--大刻度的颜色-->
        <attr name="scaleNumColor" format="color" />                 <!--刻度数的颜色-->
        <attr name="indicatorColor" format="color" />                <!--指示线颜色-->
        <attr name="smallScaleStroke" format="dimension" />          <!--小刻度的宽度-->
        <attr name="midScaleStroke" format="dimension" />            <!--中刻度的宽度-->
        <attr name="largeScaleStroke" format="dimension" />          <!--大刻度的宽度-->
        <attr name="indicatorStroke" format="dimension" />           <!--指示线的宽度-->
        <attr name="smallScaleHeight" format="dimension" />          <!--小刻度的高度-->
        <attr name="midScaleHeight" format="dimension" />            <!--中刻度的高度-->
        <attr name="largeScaleHeight" format="dimension" />          <!--大刻度的高度-->
        <attr name="indicatorHeight" format="dimension" />           <!--指示线的高度-->
        <attr name="scaleNumTextSize" format="dimension" />          <!--刻度字体大小-->
        <attr name="scaleTextMargin" format="dimension" />           <!--刻度值与刻度线的间距-->
        <attr name="rulerPaddingHorizontal" format="dimension" />    <!--尺子水平内边距-->
        <attr name="rulerPaddingVertical" format="dimension" />      <!--尺子垂直内边距-->
        <attr name="isBgRoundRect" format="boolean" />               <!--背景是否圆角-->
        <attr name="decimalPlaces" format="integer" />               <!--小数点位数-->
        <attr name="scaleLimit" format="integer" />                  <!--相邻2个刻度之间的数量-->

    </declare-styleable>

    <declare-styleable name="BloodSugarRangeView">
        <attr name="itemHeight" format="dimension" />               <!--每个条目的高度-->
        <attr name="itemSpacing" format="dimension" />              <!--条目间距-->
        <attr name="dotRadius" format="dimension" />                <!--圆点半径-->
        <attr name="itemPaddingHorizontal" format="dimension" />    <!--条目水平内边距-->
        <attr name="itemPaddingVertical" format="dimension" />      <!--条目垂直内边距-->
        <attr name="cornerRadius" format="dimension" />             <!--背景圆角半径-->
        <attr name="rangeTextSize" format="dimension" />            <!--范围文字大小-->
        <attr name="rangeTextStyle" format="enum">                  <!--文字样式-->
            <enum name="normal" value="0" />
            <enum name="bold" value="1" />
            <enum name="italic" value="2" />
        </attr>
        <attr name="dotMarginEnd" format="dimension" />             <!--圆点右边距-->
    </declare-styleable>

    <!-- LevelBar 通用自定义属性（统一命名，无兼容保留） -->
    <declare-styleable name="LevelBar">
        <!-- 进度条属性 -->
        <attr name="barHeight" format="dimension" />                  <!--进度条高度-->
        <attr name="barCornerRadius" format="dimension" />            <!--进度条圆角半径-->

        <!-- 指示器属性（统一前缀 indicator） -->
        <attr name="indicatorWidth" format="dimension" />             <!--指示器宽度-->
        <!-- 引用已在 RulerView 中声明的同名属性，避免重复声明格式 -->
        <attr name="indicatorHeight" />                                 <!--指示器高度-->
        <attr name="indicatorFillColor" format="color" />             <!--指示器填充颜色-->
        <attr name="indicatorStrokeColor" format="color" />           <!--指示器描边颜色-->
        <attr name="indicatorStrokeWidth" format="dimension" />       <!--指示器描边宽度-->
        <attr name="indicatorCornerRadius" format="dimension" />      <!--指示器圆角半径-->
    </declare-styleable>

    <!-- DateTimeSelectionView 自定义属性 -->
    <declare-styleable name="DateTimeSelectionView">
        <attr name="titleText" format="string" />          <!--标题文本-->
        <attr name="labelText" format="string" />          <!--标签文本-->
        <attr name="showLabel" format="boolean" />         <!--是否显示标签-->
    </declare-styleable>

    <!-- WeeklyDateSelector 自定义属性 -->
    <declare-styleable name="WeeklyDateSelector">
        <!-- 颜色与文字相关属性 -->
        <attr name="selectedBackgroundColor" format="color" />        <!-- 选中日期的背景颜色 -->
        <attr name="unselectedBackgroundColor" format="color" />      <!-- 未选中日期的背景颜色 -->
        <attr name="selectedTextColor" format="color" />              <!-- 选中日期的文字颜色 -->
        <attr name="unselectedTextColor" format="color" />            <!-- 未选中日期的文字颜色 -->
        <attr name="selectedWeekTextColor" format="color" />          <!-- 选中日期的周名称文字颜色，默认等于选中日期背景色 -->
        <attr name="dateTextSize" format="dimension" />               <!-- 日期数字的文字大小 -->
        <attr name="weekdayTextSize" format="dimension" />            <!-- 周名称的文字大小 -->
        <attr name="backgroundCornerRadius" format="dimension" />     <!-- 选中日期背景的圆角半径 -->

        <!-- 布局与间距相关属性 -->
        <attr name="weeklyItemSpacing" format="dimension" />          <!-- 每周内日期项之间的间距 -->
        <attr name="horizontalPadding" format="dimension" />          <!-- 每页的水平方向内边距值 -->

        <!-- 数据集大小控制属性 -->
        <attr name="previousWeeksCount" format="integer" />           <!-- 当前周之前添加的周数，0=仅当前周，-1=无限制 -->
        <attr name="nextWeeksCount" format="integer" />               <!-- 当前周之后添加的周数，0=仅当前周，-1=无限制 -->
        
        <!-- 翻页配置相关属性 -->
        <attr name="enablePagination" format="boolean" />             <!-- 是否启用翻页功能 -->
        <attr name="enableSwipeGesture" format="boolean" />           <!-- 是否启用滑动手势翻页 -->
        <attr name="swipeThreshold" format="dimension" />             <!-- 触发滑动翻页的最小距离阈值 -->

        <!-- 禁用规则相关属性 -->
        <attr name="disablePastDates" format="boolean" />             <!-- 是否禁用过去的日期选择 -->

        <!-- 周起始日配置属性 -->
        <attr name="weekStartOnMonday" format="boolean" />            <!-- 一周是否从周一开始：true=周一开始，false=周日开始 -->
        
        <!-- 自定义显示内容属性 -->
        <attr name="customWeekdayNames" format="reference" />         <!-- 自定义周名称字符串数组资源引用 -->
    </declare-styleable>

    <declare-styleable name="NumberPickerView">
        <!--set number of item displayed, default is 3-->
        <attr name="npv_ShownCount" format="reference|integer" />
        <!--set if show divider, default is true-->
        <attr name="npv_ShowDivider" format="reference|boolean" />
        <attr name="npv_DividerColor" format="reference|color" />
        <attr name="npv_DividerMarginLeft" format="reference|dimension" />
        <attr name="npv_DividerMarginRight" format="reference|dimension" />
        <attr name="npv_DividerHeight" format="reference|dimension" />
        <attr name="npv_TextColorNormal" format="reference|color" />
        <attr name="npv_TextColorSelected" format="reference|color" />
        <attr name="npv_TextColorHint" format="reference|color" />
        <attr name="npv_TextSizeNormal" format="reference|dimension" />
        <attr name="npv_TextSizeSelected" format="reference|dimension" />
        <attr name="npv_TextSizeHint" format="reference|dimension" />
        <attr name="npv_TextArray" format="reference" />
        <attr name="npv_MinValue" format="reference|integer" />
        <attr name="npv_MaxValue" format="reference|integer" />
        <attr name="npv_WrapSelectorWheel" format="reference|boolean" />
        <attr name="npv_RespondChangeOnDetached" format="reference|boolean" />
        <attr name="npv_HintText" format="reference|string" />
        <attr name="npv_EmptyItemHint" format="reference|string" />
        <attr name="npv_MarginStartOfHint" format="reference|dimension" />
        <attr name="npv_MarginEndOfHint" format="reference|dimension" />
        <attr name="npv_ItemPaddingHorizontal" format="reference|dimension" />
        <attr name="npv_ItemPaddingVertical" format="reference|dimension" />
        <attr name="npv_RespondChangeInMainThread" format="reference|boolean" />
        <attr name="npv_TextEllipsize" format="reference|string" />
        <attr name="npv_SelectedItemBackground" format="reference" />

        <!--just used to measure maxWidth for wrap_content without hint,
            the string array will never be displayed.
            you can set this attr if you want to keep the wraped numberpickerview
            width unchanged when alter the content list-->
        <attr name="npv_AlternativeTextArrayWithMeasureHint" format="reference" />
        <attr name="npv_AlternativeTextArrayWithoutMeasureHint" format="reference" />
        <!--the max length of hint content-->
        <attr name="npv_AlternativeHint" format="reference|string" />
    </declare-styleable>

    <!-- LeveStatusView 自定义属性 -->
    <declare-styleable name="LeveStatusView">
        <!-- 是否用于“添加记录”场景：true 显示圆点并启用说明弹窗；false 关闭两者 -->
        <attr name="lsvAddRecord" format="boolean" />
        <!-- 范围文本颜色（可自定义） -->
        <attr name="lsvRangeTextColor" format="color" />
        <!-- 是否展示性别/年龄信息 -->
        <attr name="lsvShowProfile" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CircleImageView">
        <attr name="android:text" />
        <attr name="android:textSize" />
        <attr name="android:textColor" />
        <attr name="borderWidth" format="dimension" />
        <attr name="borderColor" format="color" />
        <attr name="displayBorder" format="boolean" />
        <attr name="android:radius" />
        <attr name="android:topLeftRadius" />
        <attr name="android:topRightRadius" />
        <attr name="android:bottomLeftRadius" />
        <attr name="android:bottomRightRadius" />
        <attr name="displayType">
            <enum name="normal" value="0" />
            <enum name="circle" value="1" />
            <enum name="round_rect" value="2" />
        </attr>
        <attr name="displayLabel" format="boolean" />
        <attr name="labelBackground" format="color" />
        <attr name="labelWidth" format="dimension" />
        <attr name="startMargin" format="dimension" />
        <attr name="android:typeface" />
        <attr name="android:textStyle" />
        <attr name="labelGravity">
            <enum name="leftTop" value="0" />
            <enum name="leftBottom" value="1" />
            <enum name="rightTop" value="2" />
            <enum name="rightBottom" value="3" />
        </attr>
        <attr name="gradientContent">
            <enum name="none" value="0" />
            <enum name="border" value="1" />
            <enum name="label" value="2" />
            <enum name="labelBackground" value="3" />
            <enum name="all" value="4" />
        </attr>
        <attr name="android:type" />
        <attr name="android:startColor" />
        <attr name="android:centerColor" />
        <attr name="android:endColor" />
        <attr name="android:orientation" />
    </declare-styleable>

    <!-- ExpertAdviceView 专家建议视图自定义属性 -->
    <declare-styleable name="ExpertAdviceView">
        <!-- 是否显示遮罩层（同时控制模糊效果） -->
        <attr name="eav_showMask" format="boolean" />

        <!-- 倒计时秒数（默认2秒） -->
        <attr name="eav_countdownSeconds" format="integer" />

        <!-- 模糊半径（默认20f） -->
        <attr name="eav_blurRadius" format="float" />

        <!-- 专家建议文本 -->
        <attr name="eav_adviceText" format="string|reference" />

        <!-- 有遮罩时的最小高度（默认237dp） -->
        <attr name="eav_minHeightWithMask" format="dimension" />
    </declare-styleable>

</resources>
