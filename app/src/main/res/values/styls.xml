<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MaterialButton" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/dp_39</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MaterialButton.b1">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/sp_18</item>
        <item name="android:textColor">@color/white90</item>
        <item name="backgroundTint">@color/ht_selector_btn_color</item>
        <item name="rippleColor">@color/c5_8</item>
    </style>


    <style name="MaterialButton.b3">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/color_999</item>
        <item name="backgroundTint">#f6f6f6</item>
        <item name="rippleColor">@color/c5_8</item>
    </style>

    <!-- Custom DatePicker Theme -->
    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <!-- 主要颜色：选中日期、确定按钮、头部背景等 -->
        <item name="colorPrimary">@color/c5</item>
        <!-- 主要颜色的变体：日期范围连接背景等 -->
        <item name="colorPrimaryVariant">@color/c5_8</item>
        <!-- 主要颜色上的文字颜色：选中日期上的文字、头部文字 -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- 表面颜色：弹窗主体背景 -->
        <item name="colorSurface">@color/white</item>
        <!-- 表面上的文字颜色：普通日期文字 -->
        <item name="colorOnSurface">@color/t1</item>
        <!-- 次要颜色：取消按钮等 -->
        <item name="colorSecondary">@color/c5</item>
        <!-- 次要颜色上的文字 -->
        <item name="colorOnSecondary">@color/white</item>
        <!-- 按钮文字颜色 -->
        <item name="materialButtonOutlinedStyle">@style/CustomDatePickerButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDatePickerPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDatePickerNegativeButton</item>
        <!-- 隐藏编辑按钮 -->
        <item name="materialCalendarHeaderToggleButton">@style/HiddenToggleButton</item>
    </style>

    <!-- 隐藏编辑按钮样式 -->
    <style name="HiddenToggleButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:visibility">gone</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
    </style>

    <!-- Custom DatePicker Button Style -->
    <style name="CustomDatePickerButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/c5</item>
        <item name="rippleColor">@color/c5_8</item>
    </style>

    <!-- Custom DatePicker Positive Button (确认按钮) -->
    <style name="CustomDatePickerPositiveButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/ht_datepicker_positive_button_selector</item>
        <item name="rippleColor">@color/c5_8</item>
    </style>

    <!-- Custom DatePicker Negative Button (取消按钮) -->
    <style name="CustomDatePickerNegativeButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/c5</item>
        <item name="rippleColor">@color/c5_8</item>
    </style>

    <!-- Custom DatePicker Header Theme -->


    <style name="T1_18" parent="TextViewFont_RobotoBold">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/t1</item>
        <item name="android:textSize">@dimen/sp_18</item>
    </style>

    <style name="T1_14" parent="TextViewFont_RobotoRegular">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/t1</item>
        <item name="android:textSize">@dimen/sp_14</item>
    </style>


</resources>