<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextStyle" parent="BaseTextAlignStart"/>
    <style name="BaseTextAlignStart">
        <item name="android:gravity">start</item>
    </style>

    <style name="MaterialButton" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/dp_39</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MaterialButton.b1">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/c5</item>
        <item name="rippleColor">@color/c5_8</item>
    </style>
    <style name="MaterialButton.b2">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/c5</item>
        <item name="cornerRadius">@dimen/dp_8</item>
        <item name="android:textSize">@dimen/sp_14</item>
        <item name="android:paddingStart">@dimen/dp_20</item>
        <item name="android:paddingEnd">@dimen/dp_20</item>
        <item name="rippleColor">@color/c5_8</item>

    </style>

</resources>