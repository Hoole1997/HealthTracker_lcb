<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:id="@+id/totalWaterIntakeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/totalWaterIntake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/totalWaterUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginStart="2dp"
            android:textColor="#666666"/>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/totalWaterDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:textSize="14sp"
        android:textColor="#999999"/>

    <com.healthtracker.blood.suger.ui.widget.WaterCupView
        android:id="@+id/waterCupView"
        android:layout_width="230dp"
        android:layout_height="252dp"
        android:layout_marginTop="12dp"
        app:maxCups="8"
        app:currentCups="3"
        app:waterColor="#03bc78"
        app:waveAmplitude="8dp"
        app:cupWaveSpeed="60"
        app:cupTopInset="24dp"
        app:cupBottomInset="0dp"
        app:cupSideInset="12dp" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp">
        
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/ic_hydrate_subtract"
            android:layout_marginEnd="20dp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="@dimen/dp_185"
            android:layout_height="48dp"
            tools:text="Drink 100ML"
            android:textAlignment="center"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_hydrate_drink"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/ic_hydrate_add"
            android:layout_marginStart="20dp"/>
        
    </LinearLayout>

</LinearLayout>