<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/action_bar"
        layout="@layout/tr_layout_action_bar_back_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:clipToPadding="false"
        android:paddingTop="@dimen/sp_16"
        android:paddingBottom="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@id/btn_save"
        app:layout_constraintTop_toBottomOf="@id/action_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_statu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@drawable/tr_bg_rect_white_12"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="@dimen/dp_56"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_20"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextViewFont_RobotoBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tr_status"
                    android:textColor="@color/t1"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_status"
                    style="@style/TextViewFont_RobotoRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/tr_ic_blood_suger_status_arrow"
                    android:drawablePadding="@dimen/dp_8"
                    android:text="@string/tr_text_default"
                    android:textColor="@color/color_999"
                    android:textSize="@dimen/sp_14"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_value_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_16"
                android:background="@drawable/tr_bg_rect_white_12"
                android:padding="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@id/cl_statu">

                <RadioGroup
                    android:id="@+id/rg_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/tr_bg_unit_switch"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rb_mgdl"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/tr_selector_unit_tab"
                        android:button="@null"
                        android:checked="true"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:text="@string/tr_mg_dl"
                        android:textColor="@color/tr_selector_unit_text_color"
                        android:textSize="@dimen/sp_12" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/rb_mmol"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/tr_selector_unit_tab"
                        android:button="@null"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:text="@string/tr_mmol_l"
                        android:textColor="@color/tr_selector_unit_text_color"
                        android:textSize="@dimen/sp_12" />

                </RadioGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_select_value"
                    style="@style/TextViewFont_RobotoBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:includeFontPadding="false"
                    android:textColor="@color/t1"
                    android:textSize="@dimen/sp_42"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rg_unit"
                    tools:text="4.2" />

                <com.daily.health.manager.face.weight.RulerView
                    android:id="@+id/rulerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:indicatorHeight="@dimen/dp_30"
                    app:indicatorStroke="@dimen/dp_3"
                    app:isBgRoundRect="true"
                    app:largeScaleColor="#D9D9D9"
                    app:largeScaleHeight="@dimen/dp_30"
                    app:largeScaleStroke="@dimen/dp_2"
                    app:layout_constraintTop_toBottomOf="@id/tv_select_value"
                    app:midScaleColor="#D9D9D9"
                    app:midScaleHeight="@dimen/dp_22"
                    app:midScaleStroke="@dimen/dp_2"
                    app:rulerHeight="@dimen/dp_52"
                    app:scaleNumColor="@color/color_999"
                    app:scaleNumTextSize="@dimen/sp_14"
                    app:scaleTextMargin="@dimen/dp_6"
                    app:smallScaleColor="#D9D9D9"
                    app:smallScaleHeight="@dimen/dp_22"
                    app:smallScaleStroke="@dimen/dp_2"
                    tools:decimalPlaces="1"
                    tools:firstScale="4.2"
                    tools:maxScale="37"
                    tools:minScale="0"
                    tools:scaleCount="5"
                    tools:scaleStep="0.1"
                    tools:scrollableMaxScale="35"
                    tools:scrollableMinScale="1" />

                <com.daily.health.manager.face.weight.BloodSugarRangeView
                    android:id="@+id/rangeView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_24"
                    app:dotRadius="@dimen/dp_6"
                    app:itemHeight="@dimen/dp_40"
                    app:itemPaddingHorizontal="@dimen/dp_16"
                    app:itemSpacing="@dimen/dp_6"
                    app:layout_constraintTop_toBottomOf="@id/rulerView"
                    app:rangeTextSize="@dimen/sp_16" />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/cl_range_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rangeView">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_edit"
                        android:layout_width="@dimen/dp_18"
                        android:layout_height="@dimen/dp_18"
                        android:scaleType="centerCrop"
                        android:tint="@color/color_888"
                        app:srcCompat="@drawable/tr_ic_edit" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_targe_range"
                        style="@style/TextViewFont_RobotoMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_10"
                        android:text="@string/tr_target_range"
                        android:textColor="@color/color_888"
                        android:textSize="@dimen/sp_16" />

                </androidx.appcompat.widget.LinearLayoutCompat>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.daily.health.manager.face.weight.DateTimeSelectionView
                android:id="@+id/dateTimeSelectionView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:labelText="@string/tr_label"
                app:layout_constraintTop_toBottomOf="@id/cl_value_select"
                app:showLabel="true"
                app:titleText="@string/tr_date_time" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_80"
        android:background="@drawable/tr_bg_mask_bottom_btn"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/MaterialButton.b1"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginHorizontal="@dimen/dp_32"
        android:layout_marginBottom="@dimen/dp_15"
        android:text="@string/tr_save"
        app:layout_constraintBottom_toTopOf="@id/ad_Container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <FrameLayout
        android:id="@+id/ad_Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
