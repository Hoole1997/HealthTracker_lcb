<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tr_bg_rect_white_12"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_20">

    <View
        android:id="@+id/v_bar"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/tr_bg_dialog_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.daily.health.manager.face.widget.NumberPickerView
        android:id="@+id/numberPicker"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_bar"
        app:layout_constraintWidth_percent="0.8"
        app:npv_ItemPaddingHorizontal="@dimen/dp_24"
        app:npv_ItemPaddingVertical="@dimen/dp_14"
        app:npv_ShowDivider="false"
        app:npv_ShownCount="3"
        app:npv_TextColorNormal="@color/color_BFBFBF"
        app:npv_TextColorSelected="@color/t1"
        app:npv_TextSizeNormal="@dimen/sp_28"
        app:npv_TextSizeSelected="@dimen/sp_28"
        app:npv_WrapSelectorWheel="true"
        tools:npv_TextArray="@array/tr_hours" />

    <!-- 顶部渐变遮罩 -->
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:background="@drawable/tr_gradient_npv_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/numberPicker" />

    <!-- 底部渐变遮罩 -->
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:background="@drawable/tr_gradient_npv_bottom"
        app:layout_constraintBottom_toBottomOf="@id/numberPicker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/MaterialButton.b1"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/tr_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginHorizontal="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@id/numberPicker" />

</androidx.constraintlayout.widget.ConstraintLayout>