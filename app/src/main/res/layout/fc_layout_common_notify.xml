<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fc_bg_hr_notify"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical">
        <TextView
            android:id="@+id/tv_title"
            style="@style/TextViewFont_RobotoMedium"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_marginStart="16dp"
            android:maxLines="2"
            android:ellipsize="middle"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Heart rate record" />


        <TextView
            android:id="@+id/tv_btn"
            style="@style/TextViewFont_RobotoBold"
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/fc_bg_rect_white_40"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/color_FF4420"
            android:textSize="14sp"
            tools:text="View Now" />
    </LinearLayout>


</FrameLayout>