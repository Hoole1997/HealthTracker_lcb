<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fc_bg_rect_white_12"
    android:gravity="center_vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp_12"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_type"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_marginStart="16dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/fc_home_card_bs"/>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_time"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:textColor="@color/c5"
                android:textSize="@dimen/sp_16"
                tools:text="20:00" />
            <TextView
                android:id="@+id/tv_time_des"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_14"
                tools:text="Measure blood sugar 2 hours after breakfast." />

        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_12"
        android:gravity="center"
        android:layout_marginHorizontal="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_6"
        android:background="@drawable/fc_bg_rect_white_40"
        android:backgroundTint="@color/c5"
        android:textColor="@color/white"
        tools:text="Check"/>


</LinearLayout>





</FrameLayout>