<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_10">

    <View
        android:id="@+id/vFlag"
        android:layout_width="@dimen/dp_10"
        android:layout_height="@dimen/dp_48"
        android:background="@drawable/tr_bg_bp_hypotension"
        android:backgroundTint="@color/t1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLeve"
        style="@style/TextViewFont_RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:textColor="@color/t1"
        android:textSize="@dimen/sp_16"
        app:layout_constraintBottom_toTopOf="@id/tvValueRange"
        app:layout_constraintStart_toEndOf="@id/vFlag"
        app:layout_constraintTop_toTopOf="@id/vFlag" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvValueRange"
        style="@style/TextViewFont_RobotoRegular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_4"
        android:textColor="@color/t1"
        android:textSize="@dimen/sp_14"
        app:layout_constraintBottom_toBottomOf="@id/vFlag"
        app:layout_constraintStart_toEndOf="@id/vFlag"
        app:layout_constraintTop_toBottomOf="@id/tvLeve" />

</androidx.constraintlayout.widget.ConstraintLayout>