<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_20">

    <View
        android:id="@+id/v_bar"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_8"
        android:background="@drawable/bg_dialog_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 标题 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title"
        style="@style/T1_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_6"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/fsi_permission_title"
        android:textSize="@dimen/sp_16"/>

    <!-- 说明内容 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_message"
        style="@style/T1_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/dp_4"
        android:gravity="start"
        android:layout_marginHorizontal="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_12"
        android:text="@string/fsi_permission_message"
        tools:text="@string/fsi_permission_message" />

    <!-- 优势说明 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_advantages"
        style="@style/T1_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/dp_6"
        android:gravity="start"
        android:layout_marginHorizontal="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/fsi_permission_advantages"
        tools:text="@string/fsi_permission_advantages" />

    <!-- 警告说明 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_warning"
        style="@style/T1_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/dp_4"
        android:gravity="start"
        android:layout_marginHorizontal="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_8"
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_999"
        android:text="@string/fsi_permission_warning"
        tools:text="@string/fsi_permission_warning" />

    <!-- 按钮布局 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 暂不开启按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_deny_permission"
            style="@style/MaterialButton.b3"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_8"
            android:text="@string/fsi_permission_deny" />

        <!-- 允许权限按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_allow_permission"
            style="@style/MaterialButton.b1"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/allow" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>