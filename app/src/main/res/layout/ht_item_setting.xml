<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ht_bg_setting_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_24"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ht_ic_setting_language" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_action"
        style="@style/TextViewFont_RobotoBold"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:maxLines="1"
        android:textColor="@color/t1"
        android:textSize="@dimen/sp_14"
        app:autoSizeMaxTextSize="@dimen/sp_14"
        app:autoSizeMinTextSize="@dimen/sp_10"
        app:autoSizeStepGranularity="1dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon"
        app:layout_constraintEnd_toStartOf="@id/iv_arrow"
        app:layout_constraintStart_toEndOf="@id/iv_icon"
        app:layout_constraintTop_toTopOf="@id/iv_icon"
        tools:text="@string/language" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_arrow"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:background="@drawable/ht_circle_shape"
        android:backgroundTint="@color/color_f8f8f8"
        android:scaleType="center"
        android:tint="@color/color_999"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ht_ic_status_arrow" />

</androidx.constraintlayout.widget.ConstraintLayout>