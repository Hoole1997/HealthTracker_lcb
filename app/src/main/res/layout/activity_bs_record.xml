<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/actionBarSize"
        android:background="@color/c1"
        android:elevation="@dimen/dp_10"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_4"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back" />


        <androidx.appcompat.widget.AppCompatTextView
            style="@style/TextViewFont_RobotoBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/dp_44"
            android:paddingEnd="@dimen/dp_44"
            android:text="@string/new_record"
            android:textColor="@color/t1"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_statu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/bg_rect_white_12"
        android:foreground="?android:attr/selectableItemBackground"
        android:minHeight="@dimen/dp_56"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@id/action_bar">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/TextViewFont_RobotoBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status"
            android:textColor="@color/t1"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_status"
            style="@style/TextViewFont_RobotoRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_blood_suger_status_arrow"
            android:drawablePadding="@dimen/dp_8"
            android:text="@string/text_default"
            android:textColor="@color/color_999"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        android:background="@drawable/bg_rect_white_8"
        android:padding="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@id/cl_statu">

        <RadioGroup
            android:id="@+id/rg_unit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_32"
            android:background="@drawable/bg_unit_switch"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rb_mgdl"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/selector_unit_tab"
                android:button="@null"
                android:paddingHorizontal="@dimen/dp_12"
                android:text="@string/mg_dl"
                android:textColor="@color/selector_unit_text_color"
                android:textSize="@dimen/sp_12" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/rb_mmol"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/selector_unit_tab"
                android:button="@null"
                android:checked="true"
                android:paddingHorizontal="@dimen/dp_12"
                android:text="@string/mmol_l"
                android:textColor="@color/selector_unit_text_color"
                android:textSize="@dimen/sp_12" />

        </RadioGroup>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_select_value"
            style="@style/TextViewFont_RobotoBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:includeFontPadding="false"
            android:textColor="@color/t1"
            android:textSize="@dimen/sp_42"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rg_unit"
            tools:text="4.2" />

        <com.healthtracker.blood.suger.ui.weight.BloodSugarRulerView
            android:id="@+id/rulerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:decimalPlaces="1"
            app:firstScale="4.2"
            app:indicatorHeight="@dimen/dp_30"
            app:indicatorStroke="@dimen/dp_3"
            app:isBgRoundRect="true"
            app:largeScaleColor="#D9D9D9"
            app:largeScaleHeight="@dimen/dp_30"
            app:largeScaleStroke="@dimen/dp_2"
            app:layout_constraintTop_toBottomOf="@id/tv_select_value"
            app:maxScale="37"
            app:midScaleColor="#D9D9D9"
            app:midScaleHeight="@dimen/dp_22"
            app:midScaleStroke="@dimen/dp_2"
            app:minScale="0"
            app:rulerHeight="@dimen/dp_52"
            app:scaleCount="5"
            app:scaleNumColor="@color/color_999"
            app:scaleNumTextSize="@dimen/sp_14"
            app:scaleStep="0.1"
            app:scaleTextMargin="@dimen/dp_6"
            app:scrollableMaxScale="35"
            app:scrollableMinScale="1"
            app:smallScaleColor="#D9D9D9"
            app:smallScaleHeight="@dimen/dp_22"
            app:smallScaleStroke="@dimen/dp_2" />

        <com.healthtracker.blood.suger.ui.weight.BloodSugarRangeView
            android:id="@+id/rangeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            app:dotRadius="@dimen/dp_6"
            app:itemHeight="@dimen/dp_40"
            app:itemPaddingHorizontal="@dimen/dp_16"
            app:itemSpacing="@dimen/dp_6"
            app:layout_constraintTop_toBottomOf="@id/rulerView"
            app:rangeTextSize="@dimen/sp_16" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>