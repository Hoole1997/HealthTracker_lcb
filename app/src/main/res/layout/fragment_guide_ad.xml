<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/tv_skip"
        style="@style/TextViewFont_RobotoMedium"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_24"
        android:layout_margin="@dimen/dp_16"
        android:background="@color/color_f4f4f4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/h_bottom">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/h_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.6"/>

        <View
            android:id="@+id/iv_guide"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_260"
            app:srcCompat="@mipmap/ic_guide_1"
            app:layout_constraintStart_toStartOf="parent"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_guide_title"
            android:layout_marginBottom="@dimen/dp_56"
            android:background="@drawable/bg_rect_white_12"
            android:backgroundTint="@color/color_f4f4f4"/>


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_guide_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_25"
            android:gravity="center"
            android:textColor="@color/color_f4f4f4"
            android:background="@color/color_f4f4f4"
            style="@style/TextViewFont_RobotoBold"
            android:textSize="@dimen/sp_18"
            android:text="@string/guide_title_1"
            app:layout_constraintTop_toBottomOf="@id/h_guide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/dp_56"
            android:layout_marginHorizontal="@dimen/dp_48"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_guide_des"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_36"
            android:gravity="center"
            android:textColor="@color/color_f4f4f4"
            android:background="@color/color_f4f4f4"
            style="@style/TextViewFont_RobotoRegular"
            android:textSize="@dimen/sp_14"
            android:text="@string/guide_1_des"
            app:layout_constraintTop_toBottomOf="@id/tv_guide_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginHorizontal="@dimen/dp_32"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:background="@color/color_f4f4f4"
        android:layout_marginHorizontal="@dimen/dp_36"
        app:layout_constraintBottom_toTopOf="@id/h_bottom"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/h_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dp_16">
        <View
            android:layout_width="@dimen/dp_6"
            android:layout_height="@dimen/dp_6"
            android:background="@drawable/circle_shape"
            android:backgroundTint="@color/color_f4f4f4"/>
        <View
            android:layout_width="@dimen/dp_14"
            android:layout_height="@dimen/dp_6"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:background="@drawable/bg_rect_white_3"
            android:backgroundTint="@color/color_f4f4f4"/>

        <View
            android:layout_width="@dimen/dp_6"
            android:layout_height="@dimen/dp_6"
            android:background="@drawable/circle_shape"
            android:backgroundTint="@color/color_f4f4f4"
            android:layout_marginEnd="@dimen/dp_8"/>
        <View
            android:layout_width="@dimen/dp_6"
            android:layout_height="@dimen/dp_6"
            android:background="@drawable/circle_shape"
            android:backgroundTint="@color/color_f4f4f4"/>

    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/h_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.8" />

</androidx.constraintlayout.widget.ConstraintLayout>