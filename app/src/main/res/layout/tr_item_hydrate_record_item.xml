<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tr_bg_hydrate_record"
    android:layout_marginBottom="12dp"
    android:padding="@dimen/dp_12">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:src="@drawable/tr_ic_record_cup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_amount"
        style="@style/TextViewFont_RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/t1"
        android:textSize="@dimen/sp_20"
        app:layout_constraintStart_toEndOf="@id/iv_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_time"
        app:layout_goneMarginStart="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_8"
        tools:text="200" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_unit"
        style="@style/TextViewFont_RobotoMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_4"
        android:textColor="#999999"
        android:textSize="@dimen/sp_12"
        app:layout_constraintStart_toEndOf="@id/tv_amount"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_amount"
        tools:text="ML" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_time"
        style="@style/TextViewFont_RobotoMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#999999"
        android:textSize="@dimen/sp_12"
        app:layout_constraintStart_toStartOf="@id/tv_amount"
        app:layout_constraintTop_toBottomOf="@id/tv_amount"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/dp_6"
        tools:text="2025-09-09 17:00:00" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_delete"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:src="@drawable/tr_ic_delete_history"
        android:contentDescription="@string/tr_delete"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>