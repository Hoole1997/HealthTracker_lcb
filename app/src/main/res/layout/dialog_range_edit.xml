<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_dialog"
    android:paddingBottom="@dimen/dp_16">

    <View
        android:id="@+id/v_bar"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/bg_dialog_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_status_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/TextViewFont_RobotoBold"
        android:textColor="@color/t1"
        android:textSize="@dimen/sp_16"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_reset"
        app:layout_constraintTop_toBottomOf="@id/v_bar"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_8"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_4"
        android:text="@string/reset"
        android:textColor="@color/color_666"
        android:textSize="@dimen/sp_14"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_status_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_status_title" />

    <RadioGroup
        android:id="@+id/rg_unit"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_20"
        android:background="@drawable/bg_unit_switch"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_status_title">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_mgdl"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/selector_unit_tab"
            android:button="@null"
            android:checked="true"
            android:paddingHorizontal="@dimen/dp_12"
            android:text="@string/mg_dl"
            android:textColor="@color/selector_unit_text_color"
            android:textSize="@dimen/sp_12" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_mmol"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/selector_unit_tab"
            android:button="@null"
            android:paddingHorizontal="@dimen/dp_12"
            android:text="@string/mmol_l"
            android:textColor="@color/selector_unit_text_color"
            android:textSize="@dimen/sp_12" />

    </RadioGroup>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_edit_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_9"
        app:layout_constraintTop_toBottomOf="@id/rg_unit">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_15">

            <View
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_20"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_low" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_16"
                android:text="@string/blood_sugar_level_low" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:text="&lt;"
                android:textColor="@color/color_999"
                android:textSize="@dimen/sp_16" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_low_value_max"
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_edit"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_4"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12"
                tools:text="4.0" />


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_15">

            <View
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_20"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_normal" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_16"
                android:text="@string/blood_sugar_level_normal" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_normal_value_min"
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:paddingVertical="@dimen/dp_4"
                android:text="4.0"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:text="~"
                android:textColor="@color/color_999"
                android:textSize="@dimen/sp_16" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_normal_value_max"
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_edit"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_4"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12"
                tools:text="5.5" />


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_15">

            <View
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_20"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_prediabetes" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_16"
                android:text="@string/blood_sugar_level_prediabetes" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_pre_value_min"
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_4"
                android:text="5.5"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~"
                android:textColor="@color/color_999"
                android:textSize="@dimen/sp_16" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_pre_value_max"
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/dp_4"
                android:text="7.0"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12" />


        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/dp_15">

            <View
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_20"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_diabetes" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_16"
                android:text="@string/blood_sugar_level_diabetes" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_6"
                android:text="≥"
                android:textColor="@color/color_999"
                android:textSize="@dimen/sp_16" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_dis_value_min"
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_edit"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_4"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12"
                tools:text="7.0" />


        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.appcompat.widget.LinearLayoutCompat>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/MaterialButton.b1"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginEnd="@dimen/dp_8"
        android:backgroundTint="#f6f6f6"
        android:text="@string/cancel"
        android:textColor="@color/color_999"
        app:layout_constraintEnd_toStartOf="@id/btn_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_edit_value" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/MaterialButton.b1"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        android:text="@string/save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_cancel"
        app:layout_constraintTop_toTopOf="@id/btn_cancel" />


</androidx.constraintlayout.widget.ConstraintLayout>