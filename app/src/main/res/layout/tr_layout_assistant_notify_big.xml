<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tr_bg_rect_white_12"
    android:minHeight="64dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tr_bg_rect_white_12"
        android:paddingHorizontal="@dimen/dp_20"
        android:orientation="vertical"
        android:paddingVertical="11dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_type"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/tr_bg_assistant"
            android:padding="@dimen/dp_2"
            android:scaleType="centerCrop"
            android:src="@mipmap/tr_ic_assistant" />
        <TextView
            android:id="@+id/tv_title"
            style="@style/TextViewFont_RobotoMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginHorizontal="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:textColor="@color/c5"
            android:textSize="16sp"
            tools:text="From Health Assistant" />

        <TextView
            android:id="@+id/tv_content"
            style="@style/TextViewFont_RobotoMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:textColor="@color/t1"
            android:textSize="14sp"
            tools:text="I'm here to remind you to add your blood sugar record!" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_32"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/ll_neglect"
                android:layout_width="@dimen/dp_0"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/tr_bg_rect_white_40"
                android:backgroundTint="#EE5845"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/tr_ic_call_decline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/tr_assistant_neglect"
                    tools:text="Neglect" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_answer"
                android:layout_width="@dimen/dp_0"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/tr_bg_rect_white_40"
                android:backgroundTint="#02BC77"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/tr_ic_call_accept" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/tr_assistant_answer"
                    tools:text="Answer" />
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:tint="#ccc"
        android:scaleType="center"
        android:layout_gravity="end"
        android:src="@drawable/tr_ic_dialog_close"/>
</FrameLayout>