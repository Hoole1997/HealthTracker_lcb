<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:minWidth="@dimen/dp_370"
    android:keepScreenOn="true"
    android:orientation="vertical"
    tools:context=".ui.act.MedicationReminderFullScreenActivity">

   <androidx.constraintlayout.widget.ConstraintLayout
       android:id="@+id/cl_root"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_gravity="center"
       android:padding="@dimen/dp_16"
       android:layout_marginHorizontal="@dimen/dp_30"
       android:background="@drawable/bg_rect_white_12"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent">
       <androidx.appcompat.widget.AppCompatTextView
           android:id="@+id/tv_name_and_time"
           style="@style/TextViewFont_RobotoMedium"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/app_name"
           android:textColor="@color/color_666"
           android:textSize="@dimen/sp_11"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toTopOf="parent" />


       <androidx.appcompat.widget.AppCompatImageView
           android:id="@+id/iv_icon"
           android:layout_width="@dimen/dp_60"
           android:layout_height="@dimen/dp_60"
           android:layout_marginTop="@dimen/dp_12"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toBottomOf="@id/tv_name_and_time"
           app:srcCompat="@drawable/ic_fsi_hr" />

       <androidx.appcompat.widget.LinearLayoutCompat
           android:id="@+id/ll_content"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_marginStart="@dimen/dp_12"
           android:orientation="vertical"

           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintStart_toEndOf="@id/iv_icon"
           app:layout_constraintTop_toTopOf="@id/iv_icon"
           android:layout_marginTop="@dimen/dp_10">

           <androidx.appcompat.widget.AppCompatTextView
               android:id="@+id/tv_title"
               style="@style/TextViewFont_RobotoBold"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textColor="@color/t1"
               android:textSize="@dimen/sp_16"
               android:text="Here is the title" />

           <androidx.appcompat.widget.AppCompatTextView
               android:id="@+id/tv_des"
               style="@style/TextViewFont_RobotoRegular"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textColor="@color/color_999"
               android:textSize="@dimen/sp_14"
               android:text="Here is the title" />

       </androidx.appcompat.widget.LinearLayoutCompat>


       <androidx.appcompat.widget.AppCompatTextView
           android:id="@+id/tv_btn"
           style="@style/TextViewFont_RobotoBold"
           android:layout_width="match_parent"
           android:layout_height="@dimen/dp_42"
           android:layout_marginHorizontal="@dimen/dp_24"
           android:layout_marginTop="24dp"
           android:background="@drawable/bg_rect_white_40"
           android:backgroundTint="@color/c5"
           android:gravity="center"
           android:paddingHorizontal="10dp"
           android:textColor="@color/white"
           android:textSize="16sp"
           android:textStyle="bold"
           app:layout_constraintTop_toBottomOf="@id/ll_content"
           android:text="View Now" />
   </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>