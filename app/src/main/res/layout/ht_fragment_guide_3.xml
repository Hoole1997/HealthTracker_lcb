<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/h_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@mipmap/ht_ic_guide_3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/h_guide"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_guide_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/t1"
        style="@style/TextViewFont_RobotoBold"
        android:textSize="@dimen/sp_16"
        android:text="@string/disclaimers"
        app:layout_constraintTop_toBottomOf="@id/iv_guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginHorizontal="@dimen/dp_32"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_guide_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/color_666"
        style="@style/TextViewFont_RobotoRegular"
        android:paddingVertical="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_10"
        android:textSize="@dimen/sp_14"
        android:text="@string/guide_3_des"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/ht_bg_rect_white_12"
        android:backgroundTint="#F4F5F7"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_32"/>

</androidx.constraintlayout.widget.ConstraintLayout>