<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:id="@+id/totalWaterIntakeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/totalWaterIntake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_32"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/totalWaterUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginStart="2dp"
            android:textColor="#666666"/>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/totalWaterDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:textAlignment="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:textSize="14sp"
        android:textColor="#999999"/>

   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginTop="@dimen/dp_12">
       <View
           android:id="@+id/v_cup"
           android:layout_width="0dp"
           android:layout_height="0dp"
           android:layout_marginTop="@dimen/dp_8"
           android:layout_marginHorizontal="@dimen/sp_20"
           android:layout_marginBottom="@dimen/dp_7"
           app:layout_constraintTop_toTopOf="@id/v_outline"
           app:layout_constraintBottom_toBottomOf="@id/v_outline"
           app:layout_constraintStart_toStartOf="@id/v_outline"
           app:layout_constraintEnd_toEndOf="@id/v_outline"

           android:background="@drawable/tr_ic_cup_cover1"/>

       <View
           android:layout_width="@dimen/dp_0"
           android:layout_height="@dimen/dp_25"
           app:layout_constraintStart_toStartOf="@id/v_cup"
           app:layout_constraintEnd_toEndOf="@id/v_cup"
           app:layout_constraintTop_toTopOf="@id/v_cup"
           android:background="@drawable/tr_bg_cup_top"/>
       <com.daily.health.manager.face.widget.WaveLoadingView
           android:id="@+id/waterCupView"
           android:layout_width="0dp"
           android:layout_height="0dp"
           app:layout_constraintStart_toStartOf="@id/v_outline"
           app:layout_constraintEnd_toEndOf="@id/v_outline"
           app:layout_constraintBottom_toBottomOf="@id/v_outline"
           app:layout_constraintTop_toTopOf="@id/v_cup"
           android:layout_marginHorizontal="@dimen/dp_22"

           android:layout_marginBottom="@dimen/dp_10"

           app:wlv_borderWidth="0dp"
           app:wlv_round_rectangle="true"
           app:wlv_shapeType="rectangle"
           app:wlv_triangle_direction="east"
           app:wlv_waveAmplitude="20"
           app:wlv_waveInnerColor="@color/c5_8"
           app:wlv_waveColor="@color/c5" />
       <View
           android:id="@+id/v_outline"
           app:layout_constraintBottom_toBottomOf="parent"
           android:layout_width="@dimen/dp_230"
           android:layout_height="0dp"
           app:layout_constraintDimensionRatio="230:264"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           android:background="@drawable/tr_bg_cup_cover"
           />


       <View
           android:layout_width="@dimen/dp_10"
           android:layout_height="@dimen/dp_107"
           android:background="@drawable/tr_bg_cup_lite"
           app:layout_constraintStart_toStartOf="@id/waterCupView"
           android:layout_marginStart="@dimen/dp_40"
           app:layout_constraintTop_toTopOf="parent"
           android:layout_marginTop="@dimen/dp_48"/>
   </androidx.constraintlayout.widget.ConstraintLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp">
        
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drinkLess"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:src="@drawable/tr_ic_hydrate_subtract"
            android:background="@mipmap/tr_bg_drink_btn"
            android:layout_marginEnd="@dimen/dp_20"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drinkBtn"
            style="@style/MaterialButton.b1"
            android:layout_width="@dimen/dp_185"
            android:layout_height="@dimen/dp_48"
            tools:text="Drink 100ML"
            android:textAlignment="center"
            android:gravity="center"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drinkMore"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="@mipmap/tr_bg_drink_btn"
            android:padding="@dimen/dp_12"
            android:src="@drawable/tr_ic_hydrate_add"
            android:layout_marginStart="@dimen/dp_20"/>
        
    </LinearLayout>

</LinearLayout>