<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tr_bg_rect_white_12"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_20">

    <View
        android:id="@+id/v_bar"
        android:layout_width="@dimen/dp_66"
        android:layout_height="@dimen/dp_8"
        android:background="@drawable/tr_bg_dialog_bar" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title"
        style="@style/T1_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_20"
        android:gravity="center_horizontal"
        android:text="@string/tr_add_label" />

    <RadioGroup
        android:id="@+id/rg_unit"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_20"
        android:background="@drawable/tr_bg_unit_switch"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_1"
            style="@style/TextViewFont_RobotoMedium"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/tr_selector_unit_tab"
            android:button="@null"
            android:gravity="center"
            android:checked="true"
            android:paddingHorizontal="@dimen/dp_12"
            android:textColor="@color/tr_selector_unit_text_color"
            android:textSize="@dimen/sp_12"
            tools:text="Lbs" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_2"
            style="@style/TextViewFont_RobotoMedium"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/tr_selector_unit_tab"
            android:button="@null"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_12"
            android:textColor="@color/tr_selector_unit_text_color"
            android:textSize="@dimen/sp_12"
            tools:text="Kg" />

    </RadioGroup>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_select_value"
        style="@style/TextViewFont_RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:includeFontPadding="false"
        android:textColor="@color/t1"
        android:textSize="@dimen/sp_42"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rg_unit"
        tools:text="60.0" />

    <com.daily.health.manager.face.weight.RulerView
        android:id="@+id/rulerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        app:indicatorHeight="@dimen/dp_30"
        app:indicatorStroke="@dimen/dp_3"
        app:isBgRoundRect="true"
        app:largeScaleColor="#D9D9D9"
        app:largeScaleHeight="@dimen/dp_30"
        app:largeScaleStroke="@dimen/dp_2"
        app:layout_constraintTop_toBottomOf="@id/tv_select_value"
        app:midScaleColor="#D9D9D9"
        app:midScaleHeight="@dimen/dp_22"
        app:midScaleStroke="@dimen/dp_2"
        app:rulerHeight="@dimen/dp_52"
        app:scaleGap="@dimen/dp_12"
        app:scaleNumColor="@color/color_999"
        app:scaleNumTextSize="@dimen/sp_14"
        app:scaleTextMargin="@dimen/dp_6"
        app:smallScaleColor="#D9D9D9"
        app:smallScaleHeight="@dimen/dp_22"
        app:smallScaleStroke="@dimen/dp_2"
        tools:decimalPlaces="1"
        tools:firstScale="60.7"
        tools:maxScale="255"
        tools:minScale="0"
        tools:scaleCount="10"
        tools:scaleStep="0.5"
        tools:scrollableMaxScale="250"
        tools:scrollableMinScale="1" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/MaterialButton.b3"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_marginEnd="@dimen/dp_12"
            android:layout_weight="1"
            android:text="@string/tr_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ok"
            style="@style/MaterialButton.b1"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_48"
            android:layout_weight="1"
            android:text="@string/tr_save" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>