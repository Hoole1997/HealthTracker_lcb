<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/actionBarSize"
        android:background="@color/c5"

        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_4"
            android:scaleType="center"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back" />


        <androidx.appcompat.widget.AppCompatTextView
            style="@style/TextViewFont_RobotoBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/dp_44"
            android:paddingEnd="@dimen/dp_44"
            android:text="@string/result"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="@dimen/dp_10"
            android:scaleType="center"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_delete"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_header_edit" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_20"
            android:scaleType="center"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_header_delete" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="@dimen/dp_16"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/action_bar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/v_header_back"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/c5"
                app:layout_constraintBottom_toTopOf="@id/bpm_status_view"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_bpm_value"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"

                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_32"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_tags"
                app:layout_constraintBottom_toBottomOf="@id/tv_time"
                tools:text="56" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_bpm_value_unit"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_4"
                android:text="@string/bpm"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_14"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_bpm_value"
                app:layout_constraintStart_toEndOf="@id/tv_bpm_value" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_time"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_16"
                android:textColor="@color/white70"
                android:textSize="@dimen/sp_14"
                app:layout_constraintTop_toBottomOf="@id/tv_tags"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="2025-10-11 15:12" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_tags"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_14"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="end"
                app:layout_constraintStart_toEndOf="@id/tv_bpm_value_unit"
                tools:text="@string/blood_sugar_status_after_exercise" />

            <Space
                android:id="@+id/space"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@id/tv_time" />


            <View
                android:id="@+id/v_leve_status"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/bg_detail_header"
                android:minHeight="@dimen/dp_100"
                app:layout_constraintBottom_toBottomOf="@id/bpm_status_view"
                app:layout_constraintTop_toTopOf="@id/bpm_status_view" />

            <com.healthtracker.blood.suger.ui.weight.LeveStatusView
                android:id="@+id/bpm_status_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@drawable/bg_rect_white_12"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/space"
                app:lsvRangeTextColor="@color/t1" />

            
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_advance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_237"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bpm_status_view"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_rect_white_12"
                android:padding="@dimen/dp_16"
                android:orientation="vertical">
                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/iv_avatar_bg"
                    android:layout_width="@dimen/dp_26"
                    android:layout_height="@dimen/dp_26"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:round="@dimen/dp_13"
                    android:background="@color/c5"/>
                
                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    app:srcCompat="@mipmap/ic_doctor_avatar"
                    app:layout_constraintTop_toTopOf="@id/iv_avatar_bg"
                    app:layout_constraintBottom_toBottomOf="@id/iv_avatar_bg"
                    app:layout_constraintStart_toStartOf="@id/iv_avatar_bg"
                    app:layout_constraintEnd_toEndOf="@id/iv_avatar_bg"
                    app:round="@dimen/dp_12"
                    android:background="@color/c5"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    style="@style/TextViewFont_RobotoBold"
                    android:textColor="@color/t1"
                    android:textSize="@dimen/sp_16"
                    app:layout_constraintTop_toTopOf="@id/iv_avatar_bg"
                    app:layout_constraintBottom_toBottomOf="@id/iv_avatar_bg"
                    app:layout_constraintStart_toEndOf="@id/iv_avatar_bg"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/exclusive_advice"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_leve_des"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_avatar_bg"

                    android:lineSpacingExtra="@dimen/dp_4"

                    android:textColor="@color/t1"
                    android:textSize="@dimen/sp_14"
                    />
                
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_watch_ad"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                app:layout_constraintTop_toTopOf="@id/cl_advance"
                app:layout_constraintBottom_toBottomOf="@id/cl_advance"
                android:layout_marginHorizontal="@dimen/sp_16"
                android:visibility="gone">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:drawablePadding="@dimen/dp_4"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:drawableTop="@mipmap/ic_lock"
                    android:textColor="@color/t1"
                    android:textSize="@dimen/sp_16"
                    style="@style/TextViewFont_RobotoBold"
                    android:text="@string/watch_ads_to_see_exclusive_advice"/>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_count_down"
                        style="@style/MaterialButton.b1"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_48"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:layout_weight="1"
                        tools:text="2s" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel"
                        style="@style/MaterialButton.b1"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_48"
                        android:layout_weight="1"
                        android:text="@string/cancel" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.constraintlayout.widget.ConstraintLayout>
            

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>