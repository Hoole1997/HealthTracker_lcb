<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginVertical="@dimen/dp_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rect_white_12"
    android:padding="@dimen/dp_16">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_leve_status"
        style="@style/TextViewFont_RobotoBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/t1"
        android:textSize="@dimen/sp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/text_default" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:tint="@color/color_888"
        app:layout_constraintBottom_toBottomOf="@id/tv_leve_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_leve_status"
        app:srcCompat="@drawable/ic_edit" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintTop_toBottomOf="@id/tv_leve_status">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_low"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cl_normal">

            <View
                android:id="@+id/v_flag_low"
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_0"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_low"
                app:layout_constraintBottom_toBottomOf="@id/tv_leve_low_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_leve_low_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_low_name"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_14"
                app:layout_constraintStart_toEndOf="@id/v_flag_low"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/blood_sugar_level_low" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_low_value"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_marginTop="@dimen/dp_6"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12"
                app:layout_constraintStart_toEndOf="@id/v_flag_low"
                app:layout_constraintTop_toBottomOf="@id/tv_leve_low_name"
                tools:text="4.0" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_normal"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/cl_low"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/v_normal_flag"
                android:layout_width="@dimen/dp_3"
                android:layout_height="0dp"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_normal"
                app:layout_constraintBottom_toBottomOf="@id/tv_leve_normal_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_leve_normal_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_normal_name"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_14"
                app:layout_constraintStart_toEndOf="@id/v_normal_flag"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/blood_sugar_level_normal" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_normal_value"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_marginTop="@dimen/dp_6"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12"
                app:layout_constraintStart_toEndOf="@id/v_normal_flag"
                app:layout_constraintTop_toBottomOf="@id/tv_leve_normal_name"
                tools:text="4.0~5.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_pre"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_low"
            app:layout_constraintEnd_toStartOf="@id/cl_dia"
            android:layout_marginTop="@dimen/dp_20">

            <View
                android:id="@+id/v_pre_flag"
                android:layout_width="@dimen/dp_3"
                android:layout_height="0dp"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_prediabetes"
                app:layout_constraintBottom_toBottomOf="@id/tv_leve_pre_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_leve_pre_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_pre_name"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_14"
                app:layout_constraintStart_toEndOf="@id/v_pre_flag"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/blood_sugar_level_prediabetes" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_pre_value"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_marginTop="@dimen/dp_6"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12"
                app:layout_constraintStart_toEndOf="@id/v_pre_flag"
                app:layout_constraintTop_toBottomOf="@id/tv_leve_pre_name"
                tools:text="4.0~5.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_dia"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/cl_pre"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cl_pre">

            <View
                android:id="@+id/v_dia_flag"
                android:layout_width="@dimen/dp_3"
                android:layout_height="0dp"
                android:background="@drawable/bg_bp_hypotension"
                android:backgroundTint="@color/color_diabetes"
                app:layout_constraintBottom_toBottomOf="@id/tv_leve_dia_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_leve_dia_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_dia_name"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_14"
                app:layout_constraintStart_toEndOf="@id/v_dia_flag"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/blood_sugar_level_prediabetes" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_leve_dia_value"
                style="@style/TextViewFont_RobotoRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_13"
                android:layout_marginTop="@dimen/dp_6"
                android:includeFontPadding="false"
                android:textColor="@color/t1"
                android:textSize="@dimen/sp_12"
                app:layout_constraintStart_toEndOf="@id/v_dia_flag"
                app:layout_constraintTop_toBottomOf="@id/tv_leve_dia_name"
                tools:text="4.0~5.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>