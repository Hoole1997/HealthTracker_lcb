<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="162dp"
    android:background="@drawable/ht_bg_rect_white_12"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"

    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"

            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:tint="@color/c5"
                android:src="@drawable/ht_ic_remind_notify"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_title"
                    style="@style/TextViewFont_RobotoBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:textColor="@color/t1"
                    android:textSize="18sp"
                    tools:text="11:39" />
                <TextView
                    android:id="@+id/tv_content"
                    style="@style/TextViewFont_RobotoMedium"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="4dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/t1"
                    android:textSize="14sp"
                    tools:text="It's time to take medicine." />
            </LinearLayout>
        </LinearLayout>

       <FrameLayout
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:orientation="vertical">
           <ImageView
               android:id="@+id/iv_close"
               android:layout_width="@dimen/dp_24"
               android:layout_height="@dimen/dp_24"
               android:tint="@color/color_999"
               android:scaleType="center"
               android:layout_gravity="end"
               android:src="@drawable/ht_ic_dialog_close"/>
           <ImageView
               android:id="@id/ic_bg_icon"
               android:layout_width="48dp"
               android:layout_height="48dp"
               android:layout_marginEnd="@dimen/dp_20"
               android:layout_marginTop="@dimen/dp_16"
               android:src="@mipmap/ht_ic_meds_notify_big"/>

       </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_btn"
        style="@style/TextViewFont_RobotoBold"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="18dp"
        android:textStyle="bold"
        android:background="@drawable/ht_bg_rect_white_40"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:textColor="@color/white"
        android:backgroundTint="@color/c5"
        android:textSize="16sp"
        tools:text="View Now" />


</LinearLayout>