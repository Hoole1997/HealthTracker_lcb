<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fl_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="162dp">

    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tr_bg_hr_notify"/>

    <ImageView
        android:id="@+id/ic_bg_icon"
        android:layout_width="162dp"
        android:layout_height="162dp"
        android:layout_gravity="end"
        android:src="@mipmap/tr_bg_hr_notify_icon" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="11dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/tr_ic_hr_notify"/>

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextViewFont_RobotoBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="18sp"
                tools:text="Heart rate record"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_content"
                style="@style/TextViewFont_RobotoMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="4"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="Heart rate data fluctuates? Checkout the correspondence status and…" />
        </LinearLayout>



        <TextView
            android:id="@+id/tv_btn"
            style="@style/TextViewFont_RobotoBold"
            android:layout_width="match_parent"
            android:textStyle="bold"
            android:layout_height="45dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/tr_bg_rect_white_40"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/color_FF4420"
            android:textSize="16sp"
            tools:text="View Now" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:tint="@color/white"
        android:scaleType="center"
        android:layout_gravity="end"
        android:src="@drawable/tr_ic_dialog_close"
        android:visibility="gone"/>

</FrameLayout>