<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_4"
    android:paddingTop="@dimen/dp_28"
    android:paddingBottom="@dimen/dp_20"
    android:background="@drawable/bg_location_search_dialog">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_8"
        android:padding="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@id/et_input"
        app:layout_constraintStart_toStartOf="@id/et_input"
        app:layout_constraintTop_toTopOf="@id/et_input"
        app:srcCompat="@drawable/ic_search" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_input"
        style="@style/TextViewFont_RobotoRegular"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_40"
        android:background="@drawable/bg_search_input"
        android:gravity="center_vertical"
        android:hint="@string/search"
        android:paddingStart="@dimen/dp_40"
        android:inputType="textCapWords"
        android:paddingEnd="@dimen/dp_16"
        android:textColor="@color/color_333"
        android:textColorHint="#C8C8C8"
        android:textSize="@dimen/sp_14"
        app:layout_constraintEnd_toStartOf="@id/iv_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@id/et_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/et_input"
        app:srcCompat="@drawable/ic_close_search" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_current_location_title"
        style="@style/TextViewFont_RobotoMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_22"
        android:text="@string/current_location"
        android:textColor="@color/color_333"
        android:textSize="@dimen/sp_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_input" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_locations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dp_14"
        android:clipToPadding="false"
        tools:itemCount="12"
        tools:listitem="@layout/item_location"
        app:layout_constraintTop_toBottomOf="@id/tv_current_location_title"/>






</androidx.constraintlayout.widget.ConstraintLayout>